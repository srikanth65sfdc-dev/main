<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exp_should_not_be_future_time</fullName>
    <active>true</active>
    <errorConditionFormula>TODAY()-DATEVALUE( Expense_Date_time__c )&lt;1</errorConditionFormula>
    <errorDisplayField>Expense_Date_time__c</errorDisplayField>
