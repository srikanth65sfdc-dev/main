<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Attendee_associated_with_event</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Event__r.Live__c = False,  Event__r.Remaining_Seats__c  &lt;= 0, DATEVALUE(   Event__r.End_Date_Time__c  ) - TODAY() &lt; 0)</errorConditionFormula>
    <errorDisplayField>Attendee__c</errorDisplayField>
    <errorMessage>Attendee_associated_with_event with furture Date.</errorMessage>
</ValidationRule>
