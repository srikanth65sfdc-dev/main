<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Event_type_is_virtual_Location_not_must</fullName>
    <active>true</active>
    <errorConditionFormula>IF( ISPICKVAL( Event_Type__c , &apos;Virtual&apos;) , (!ISBLANK( Location__r.Name)),False)</errorConditionFormula>
    <errorDisplayField>Location__c</errorDisplayField>
    <errorMessage>If the event type is virtual then location no required.</errorMessage>
</ValidationRule>
