<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Recurring_on_Check_is_Yes</fullName>
    <active>true</active>
    <description>If Recurring box is checked then frequency field be filled.</description>
    <errorConditionFormula>AND( Recurring__c , ISBLANK( TEXT( Frequency__c )) )</errorConditionFormula>
    <errorDisplayField>Frequency__c</errorDisplayField>
    <errorMessage>Provide the frequency field</errorMessage>
</ValidationRule>
