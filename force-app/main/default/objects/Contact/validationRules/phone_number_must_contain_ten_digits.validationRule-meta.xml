<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>phone_number_must_contain_ten_digits</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(REGEX(Phone, &quot;\\D*?(\\d\\D*?){10}&quot;))</errorConditionFormula>
    <errorMessage>phone number must contain 10 digits</errorMessage>
</ValidationRule>
